import json
import os
import pandas as pd
from collections import Counter
from groq import Groq
from dotenv import load_dotenv

# Load API Key
load_dotenv()
client = Groq(api_key=os.getenv("GROQ_API_KEY"))

# Paths
INPUT_JSON = "data/processed_eval_data.json"
OUTPUT_ALIGNMENT_CSV = "data/llm_category_alignment_scores.csv"

def get_llm_judgment():
    # 1. LOAD DATA
    if not os.path.exists(INPUT_JSON):
        print(f"Error: {INPUT_JSON} not found.")
        return

    with open(INPUT_JSON, 'r') as f:
        data = json.load(f)

    # 2. GROUP TITLES BY CATEGORY
    # key: category, value: list of all titles found in that category
    category_map = {}
    for entry in data:
        cat = entry.get("ground_truth_cat")
        # Extract title from the intent object
        title = entry.get("intent", {}).get("title")
        
        if cat not in category_map:
            category_map[cat] = []
        
        if title:
            # Handle if title is a list or string
            if isinstance(title, list):
                category_map[cat].extend(title)
            else:
                category_map[cat].append(title)

    results = []

    print(f"🚀 Analyzing {len(category_map)} categories using Llama-3.3-70B...")

    # 3. PROCESS EACH CATEGORY
    for cat, titles in category_map.items():
        # Get the 30 most frequent titles to represent the category's typical output
        common_titles = [t for t, count in Counter(titles).most_common(30)]
        
        if not common_titles:
            print(f"⚠️ Skipping {cat}: No titles found.")
            continue

        prompt = f"""
        Role: Recruitment & Industry Expert.
        Task: Evaluate the semantic alignment between a 'Ground Truth Category' and a list of 'Extracted Job Titles'.
        
        Ground Truth Category: {cat}
        Sample of Extracted Titles: {", ".join(common_titles)}
        
        Instructions:
        - Score from 0 to 100.
        - High Score (80-100): The titles are direct roles, synonyms, or subsets within that industry (e.g., 'BPO' -> 'Customer Service', 'ADVOCATE' -> 'Legal Associate').
        - Medium Score (50-79): The titles are tangentially related but slightly off-base.
        - Low Score (0-49): The titles describe a completely different industry.
        
        Output ONLY a JSON object: {{"score": <int>, "reason": "<1-sentence explanation>"}}
        """

        try:
            chat_completion = client.chat.completions.create(
                model="llama-3.3-70b-versatile",
                messages=[{"role": "user", "content": prompt}],
                response_format={"type": "json_object"},
                temperature=0.0
            )
            
            response_data = json.loads(chat_completion.choices[0].message.content)
            
            results.append({
                "category": cat,
                "llm_alignment_score": response_data.get("score"),
                "reason": response_data.get("reason"),
                "sample_titles_evaluated": len(common_titles)
            })
            
            print(f"✅ {cat}: {response_data.get('score')}/100")

        except Exception as e:
            print(f"❌ Error evaluating {cat}: {e}")

    # 4. SAVE TO CSV
    df_results = pd.DataFrame(results)
    df_results.to_csv(OUTPUT_ALIGNMENT_CSV, index=False)
    print(f"\n✨ Evaluation complete! Scores saved to: {OUTPUT_ALIGNMENT_CSV}")

if __name__ == "__main__":
    get_llm_judgment()